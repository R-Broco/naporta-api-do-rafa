// Configuração de conexão com o banco de dados e geração do Client tipado
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


// Entidade agregadora de Pedidos com suporte a Soft Delete e relacionamento 1:N
model Pedido {
  id                  String    @id @default(uuid())
  numero              String    @unique
  dataPrevisaoEntrega DateTime
  clienteNome         String
  clienteDocumento    String
  enderecoEntrega     String
  status              String    @default("PENDENTE")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?
  items               Item[]
}

// Itens vinculados ao pedido com precisão decimal fixa e deleção em cascata
model Item {
  id          String   @id @default(uuid())
  descricao   String
  preco       Decimal  @db.Decimal(10, 2)
  pedidoId    String
  pedido      Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
}
